{
  "expo": {
    "scheme": "progressive-loading",
    "icon": "./assets/app_icon.png",
    "name": "app",
    "slug": "app",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#10B981",
      "image": "./assets/images/app_splash_screen_light.png",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen"
    ]
  }
}
