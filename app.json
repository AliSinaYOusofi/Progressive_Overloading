{
  "expo": {
    "scheme": "progressive-loading",
    "icon": "./assets/images/icon.png",
    "name": "Progressive Overloading",
    "slug": "progressive-overloading",
    "version": "1.0.1",
    "userInterfaceStyle": "automatic",
    "description": "Track your strength training progress with progressive overloading. Log sets, monitor goals, and analyze your fitness journey.",
    "orientation": "portrait",
    "splash": {
      "backgroundColor": "#10B981",
      "image": "./assets/images/app_splash_screen_light.png",
      "resizeMode": "contain",
      "dark": {
        "backgroundColor": "#059669",
        "image": "./assets/images/app_splash_screen_light.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "./plugins/withNoMacCatalyst.js",
      "expo-font",
      "expo-apple-authentication"
    ],
    "ios": {
      "jsEngine": "jsc",
      "bundleIdentifier": "com.progressiveoverloading.app",
      "buildNumber": "2",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "splash": {
        "backgroundColor": "#10B981",
        "image": "./assets/images/app_splash_screen_light.png",
        "resizeMode": "contain",
        "dark": {
          "backgroundColor": "#059669",
          "image": "./assets/images/app_splash_screen_light.png"
        }
      }
    },
    "android": {
      "package": "com.progressiveoverloading.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app_icon.png",
        "backgroundColor": "#10B981"
      },
      "splash": {
        "backgroundColor": "#10B981",
        "image": "./assets/images/app_splash_screen_light.png",
        "resizeMode": "contain",
        "dark": {
          "backgroundColor": "#059669",
          "image": "./assets/images/app_splash_screen_light.png"
        }
      },
      "permissions": []
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56db97cd-60d3-4cae-930f-c1070fc1ca00"
      },
      "apple": {
        "category": "Health & Fitness",
        "keywords": [
          "fitness",
          "workout",
          "gym",
          "strength training",
          "progressive overload",
          "exercise tracking",
          "weightlifting",
          "bodybuilding",
          "fitness tracker",
          "workout log"
        ],
        "subtitle": "Track your training progress"
      }
    }
  }
}
