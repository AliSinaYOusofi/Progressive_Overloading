create table public.exercises (
  id uuid not null default gen_random_uuid (),
  user_id uuid not null,
  name text not null,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  constraint exercises_pkey primary key (id),
  constraint fk_exercises_user foreign KEY (user_id) references profiles (id) on delete CASCADE
) TABLESPACE pg_default;

create unique INDEX IF not exists exercises_user_name_uniq on public.exercises using btree (user_id, lower(name)) TABLESPACE pg_default;


create table public.exercise_sets (
  id uuid not null default gen_random_uuid (),
  user_id uuid not null,
  exercise_id uuid not null,
  performed_at timestamp with time zone not null default now(),
  weight numeric(8, 2) not null,
  reps integer not null,
  unit text not null default 'kg'::text,
  rpe numeric(3, 1) null,
  notes text null,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  sets integer null,
  constraint exercise_sets_pkey primary key (id),
  constraint fk_sets_exercise foreign KEY (exercise_id) references exercises (id) on delete CASCADE,
  constraint fk_sets_user foreign KEY (user_id) references profiles (id) on delete CASCADE,
  constraint exercise_sets_reps_check check (
    (
      (reps > 0)
      and (reps <= 100)
    )
  ),
  constraint exercise_sets_rpe_check check (
    (
      (rpe is null)
      or (
        (rpe >= (1)::numeric)
        and (rpe <= (10)::numeric)
      )
    )
  ),
  constraint exercise_sets_weight_check check ((weight >= (0)::numeric))
) TABLESPACE pg_default;

create index IF not exists exercise_sets_user_exercise_time_idx on public.exercise_sets using btree (user_id, exercise_id, performed_at desc) TABLESPACE pg_default;

create index IF not exists exercise_sets_user_time_idx on public.exercise_sets using btree (user_id, performed_at desc) TABLESPACE pg_default;


create table public.fitness_goals (
  id uuid not null default gen_random_uuid (),
  user_id uuid not null,
  title text not null,
  description text null,
  target_value numeric(8, 2) null,
  current_value numeric(8, 2) null default 0,
  unit text null,
  target_date date null,
  is_completed boolean null default false,
  completed_at timestamp with time zone null,
  created_at timestamp with time zone null default now(),
  updated_at timestamp with time zone null default now(),
  constraint fitness_goals_pkey primary key (id),
  constraint fitness_goals_user_id_fkey foreign KEY (user_id) references profiles (id) on delete CASCADE,
  constraint fk_fitness_goals_user foreign KEY (user_id) references auth.users (id) on delete CASCADE
) TABLESPACE pg_default;